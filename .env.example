# Google Drive backup/restore (Settings → Sauvegarde Google).
# Both values come from ONE Google Cloud project (see docs/google-setup.md).
# These are PUBLIC client credentials — they ship in the browser bundle by design;
# restrict them in Google Cloud to your authorized origins (Client ID) and HTTP
# referrers (API key).
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=

# === Server-only — used by the Vercel Functions in api/auth/ ===
# NEVER prefix these with VITE_: that would ship them in the browser bundle.
# On Vercel, set all three under Settings → Environment Variables
# (Production AND Preview). See docs/google-setup.md.

# From client_secret_*.json → web.client_secret
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Encrypts the Google refresh token inside the httpOnly session cookie.
# Changing it signs every device out; it does not revoke access at Google.
SESSION_SECRET=
# The exact origin this deployment is served from — the OAuth redirect URI is
# built from it (${APP_ORIGIN}/api/auth/callback) and it is never derived from
# the request Host header, which would be a host-header-injection open redirect.
APP_ORIGIN=http://localhost:5173
